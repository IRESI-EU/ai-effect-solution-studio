POSTGRES_DB=solution_studio
POSTGRES_USER=solution_studio
POSTGRES_PASSWORD=replace_with_a_long_random_value
ORCHESTRATOR_API_KEY=replace_with_the_orchestrator_api_key
STUDIO_BIND_ADDRESS=127.0.0.1
