+def _restart_villasnode(config_path: str):
+    """Load a config, tolerating a native restart crash after an earlier run."""
+    restart_url = f"{VILLAS_NODE_URL}/api/v2/restart"
+    last_error = None
+
+    for attempt in range(1, RESTART_RETRIES + 1):
+        try:
+            response = requests.post(
+                restart_url,
+                json={"config": config_path},
+                timeout=30,
+            )
+            response.raise_for_status()
+            return response
+        except requests.ConnectionError as error:
+            last_error = error
+            if attempt == RESTART_RETRIES:
+                break
+            logger.warning(
+                "VILLASnode connection reset during restart; retrying "
+                f"({attempt}/{RESTART_RETRIES})"
+            )
+            time.sleep(RESTART_RETRY_INTERVAL)
+
+    raise last_error
+
+
