+def _files_with_data_rows(paths):
+    """Return CSV paths containing a header and at least one data row."""
+    usable = []
+    for path in paths:
+        with open(path, encoding="utf-8", errors="replace") as source:
+            if sum(1 for line in source if line.strip()) > 1:
+                usable.append(path)
+    return usable
+
+
 def execute_ProvideData(request) -> ExecuteResponse:
