     # Copy converted load files (sorted for deterministic ordering)
     load_files = sorted(glob.glob(os.path.join(DATA_DIR, "loads", "*_converted.csv")))
+    usable_load_files = _files_with_data_rows(load_files)
+    if len(usable_load_files) != len(load_files) or not usable_load_files:
+        return ExecuteResponse(
+            status="failed", error="One or more converted load CSV files contain no data rows"
+        )
     for f in load_files:
         shutil.copy2(f, loads_dir)
