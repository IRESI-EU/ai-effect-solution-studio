POSTGRES_DB=solution_studio
POSTGRES_USER=solution_studio
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://solution_studio:change_me@postgres:5432/solution_studio

ORCHESTRATOR_BASE_URL=http://host.docker.internal:18000
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080
NEXT_PUBLIC_ENVIRONMENT_LABEL=Local environment

# Initial administrator. Use a unique 12+ character password, start the API once,
# then remove BOOTSTRAP_ADMIN_PASSWORD from the environment file.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
SECURE_COOKIES=false
SESSION_HOURS=12
