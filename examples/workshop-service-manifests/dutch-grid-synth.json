{
  "schema_version": "1.0",
  "service": {
    "id": "workshop-nl-grid-synth",
    "name": "[Workshop] Dutch Grid Synthesizer",
    "provider": "AI-EFFECT Dutch Node",
    "category": "Dutch Use Case Workshop",
    "version": "1.0",
    "description": "Workshop-only onboarding copy derived from the Dutch Node grid_synth_service. Do not approve it as a second production service.",
