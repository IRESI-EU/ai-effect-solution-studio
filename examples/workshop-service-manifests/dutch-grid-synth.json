    "output_message_name": "GetGridDataResponse",
    "contract_uri": "use-cases/dutch_node/data_synthesizer/microservice/data_synthesizer.proto",
    "proto_uri": "microservice/data_synthesizer.proto"
  },
  "orchestration": {
    "mode": "native"
  }
