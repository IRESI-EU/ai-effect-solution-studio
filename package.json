{
  "name": "ai-effect-solution-studio",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @ai-effect/web dev",
    "dev:web": "pnpm --filter @ai-effect/web dev",
    "build:web": "pnpm --filter @ai-effect/web build",
    "lint:web": "pnpm --filter @ai-effect/web lint",
    "typecheck:web": "pnpm --filter @ai-effect/web typecheck"
  }
}
