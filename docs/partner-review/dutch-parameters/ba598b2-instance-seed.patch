+"""Argument-delivery tests only: no algorithm, workflow, server or network.
+
+Run with the service's existing dependencies:
+  python -m unittest discover -s tests/unit -v
+All synthesis/physics constructors and inter-service I/O are replaced below.
+"""
+import base64
+import hashlib
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import Mock, patch
+
+import grpc
+import networkx as nx
+from fastapi.testclient import TestClient
+from pydantic import ValidationError
+
+from common import control_interface as control
+from common import synth_operations as ops
+from common.instance_parameters import (
+    CONTRACT_VERSION, EXECUTION_PARAMETERS, OPERATION_IDENTITY, capabilities,
+)
+from common.parameter_contract import match_wrapper_configuration
+from common.task_manager import TaskManager
+
+
+def envelope(seed=43):
+    return {
+        "contract_id": "unconfirmed-review-contract",
+        "contract_version": CONTRACT_VERSION,
+        "operation_identity": OPERATION_IDENTITY,
+        "schema_version": "1.0",
+        "parameters": {"seed": seed},
+        "instance_id": "review-generator-instance",
+    }
+
+
+def inline(value):
+    return {"protocol": "inline", "format": "json",
+            "uri": base64.b64encode(json.dumps(value).encode()).decode()}
+
+
+class InstanceParameterDelivery(unittest.TestCase):
+    def setUp(self):
+        self.manager = TaskManager()
+        self.manager.register("protected-task", "complete", output="preserved-output")
+        self.manager.store_data("protected-task", "preserved-data", "text")
+        self.old_config = ops._cached_config_response
+        self.old_grid = ops._cached_grid_response
+        self.addCleanup(setattr, ops, "_cached_config_response", self.old_config)
+        self.addCleanup(setattr, ops, "_cached_grid_response", self.old_grid)
+        self.original_config = ops.data_synthesizer_pb2.GetGridConfigResponse(
+            success=True, message="preserved configuration")
+        self.original_grid = ops.data_synthesizer_pb2.GetGridDataResponse(
+            success=True, message="preserved grid")
+        ops._cached_config_response = self.original_config
+        ops._cached_grid_response = self.original_grid
+
+        def replace(target, **kwargs):
+            p = patch(target, **kwargs)
+            self.addCleanup(p.stop)
+            return p.start()
+
+        replace("common.control_interface.task_manager", new=self.manager)
+        replace("common.synth_operations.get_task_manager", return_value=self.manager)
+        self.configurator = replace("common.synth_operations.InputConfigurator")
+        self.configurator.return_value.create_params.return_value = {
+            "degrees_by_level": [[1, 1]], "diameters_by_level": [1],
+            "transformer_degrees": {},
+        }
+        self.generator = replace("common.synth_operations.PowerGridGenerator")
+        self.generator.return_value.generate_grid.return_value = nx.Graph([(0, 1)])
+        for name in ("BusTypeAllocator", "CapacityAllocator", "LoadAllocator",
+                     "GenerationDispatcher", "TransmissionLineAllocator"):
+            replace("common.synth_operations." + name)
+        replace("common.synth_operations._grid_to_pandapower_json",
+                return_value="SYNTHETIC TEST DOUBLE ONLY; not a power grid result")
+        self.fetch = replace("common.synth_operations._fetch_grid_config_from_upstream",
+                             side_effect=lambda uri: ops._cached_config_response)
+        for target in ("socket.create_connection", "socket.socket.connect",
+                       "grpc.insecure_channel", "httpx.get"):
+            replace(target, side_effect=AssertionError("Network is disabled in unit tests"))
+        self.client = TestClient(control.create_app(ops.synth_handlers))
+        self.addCleanup(self.client.close)
+
+    def post(self, **changes):
+        body = {"method": "ConfigureAndSynthesize", "workflow_id": "unit-only",
+                "task_id": "protected-task", "inputs": []}
+        body.update(changes)
+        return self.client.post("/control/execute", json=body)
+
+    def assert_delivered(self, response, seed):
+        self.assertEqual(response.status_code, 200, response.text)
+        self.assertEqual(response.json()["status"], "complete")
+        self.configurator.assert_called_once_with(seed=seed)
+        self.generator.assert_called_once_with(seed=seed)
+        self.configurator.return_value.create_params.assert_called_once()
+        self.generator.return_value.generate_grid.assert_called_once()
+        self.assertEqual(ops._cached_config_response.config.seed, seed)
+        self.assertEqual(ops._cached_grid_response.grid_data.seed, seed)
+        self.assertEqual(ops._cached_grid_response.grid_data.source_config.seed, seed)
+
+    def assert_untouched(self, response):
+        self.assertEqual(response.status_code, 422, response.text)
+        self.configurator.assert_not_called()
+        self.generator.assert_not_called()
+        self.fetch.assert_not_called()
+        self.assertIs(ops._cached_config_response, self.original_config)
+        self.assertIs(ops._cached_grid_response, self.original_grid)
+        self.assertEqual(self.manager.get_status("protected-task"),
+                         {"status": "complete", "output": "preserved-output",
+                          "error": None, "progress": 0})
+        self.assertEqual(self.manager.get_data("protected-task"), ("preserved-data", "text"))
+
+    def test_omitted_override_delivers_default_42(self):
+        self.assert_delivered(self.post(), 42)
+
+    def test_seedless_legacy_inline_retains_default_42(self):
+        self.assert_delivered(self.post(inputs=[inline({})]), 42)
+
+    def test_valid_envelope_delivers_43_through_actual_control_handlers(self):
+        self.assert_delivered(self.post(configuration=envelope()), 43)
+
+    def test_explicit_effective_default_is_accepted(self):
+        self.assert_delivered(self.post(configuration=envelope(42)), 42)
+
+    def test_zero_is_valid_http_seed_without_coercion(self):
+        self.assert_delivered(self.post(configuration=envelope(0)), 0)
+
+    def test_signed_int32_upper_bound_is_forwarded(self):
+        self.assert_delivered(self.post(configuration=envelope(2**31 - 1)), 2**31 - 1)
+
+    def test_invalid_seed_values_reject_before_mutation(self):
+        for value in (True, False, "43", 43.0, 43.5, None, -1, 2**31, [], {}):
+            with self.subTest(value=value):
+                self.assert_untouched(self.post(configuration=envelope(value)))
+
+    def test_unknown_or_missing_effective_parameters_reject(self):
+        for values in ({}, {"seed": 43, "unknown": 1}, None, ["seed", 43]):
+            with self.subTest(parameters=values):
+                config = envelope()
+                config["parameters"] = values
+                self.assert_untouched(self.post(configuration=config))
+
+    def test_envelope_version_identity_and_shape_reject(self):
+        changes = [
+            {"schema_version": "2.0"}, {"schema_version": 1},
+            {"contract_version": "1.0.0"}, {"operation_identity": "wrong-operation"},
+            {"transport": "http-parameters-v2"}, {"instance_id": ""},
+            {"contract_id": ""}, {"parameters": {"seed": 43}, "extra": 1},
+        ]
+        for changeset in changes:
+            with self.subTest(changes=changeset):
+                self.assert_untouched(self.post(configuration={**envelope(), **changeset}))
+        missing = envelope()
+        del missing["contract_version"]
+        self.assert_untouched(self.post(configuration=missing))
+        self.assert_untouched(self.post(configuration=None))
+
+    def test_bare_parameters_are_not_a_second_transport(self):
+        self.assert_untouched(self.post(parameters={"seed": 43}))
+        self.assert_untouched(self.post(parameters=None))
+        self.assert_untouched(self.post(parameters={"seed": 43}, configuration=envelope()))
+
+    def test_dual_seed_sources_reject_even_if_equal(self):
+        for seed in (42, 43):
+            with self.subTest(inline_seed=seed):
+                response = self.post(inputs=[inline({"seed": seed})], configuration=envelope())
+                self.assert_untouched(response)
+                self.assertIn("supply it exactly once", response.text)
+
+    def test_envelope_and_seedless_valid_inline_combine(self):
+        values = {"level_specs": [{"n": 2, "avg_k": 1, "diam": 1, "dist_type": "dgln"}],
+                  "connection_specs": {}, "loading_level": "L", "ref_sys_id": 2}
+        self.assert_delivered(self.post(inputs=[inline(values)], configuration=envelope()), 43)
+        self.configurator.return_value.create_params.assert_called_once_with(
+            values["level_specs"], {})
+        self.assertEqual(ops._cached_grid_response.grid_data.loading_level, "L")
+        self.assertEqual(ops._cached_grid_response.grid_data.ref_sys_id, 2)
+
+    def test_valid_legacy_inline_remains_compatible(self):
+        self.assert_delivered(self.post(inputs=[inline({"seed": 73})]), 73)
+
+    def test_legacy_individual_control_operations_remain_compatible(self):
+        configured = self.post(method="ConfigureGrid", inputs=[inline({"seed": 73})])
+        self.assertEqual(configured.json()["status"], "complete")
+        self.generator.assert_not_called()
+        synthesized = self.post(method="SynthesizeGrid",
+                                inputs=[configured.json()["output"]])
+        self.assert_delivered(synthesized, 73)
+
+    def test_invalid_or_ambiguous_inline_never_falls_back(self):
+        bad = [
+            [inline({"seed": "43"})], [inline({"seed": True})],
+            [inline({"seed": -1})], [inline({"seed": 2**31})],
+            [inline({"unknown": 43})], [inline([])], [inline(None)],
+            [{"protocol": "inline", "uri": "invalid base64!", "format": "json"}],
+            [{"protocol": "grpc", "uri": "never-connect", "format": "GetGridConfig"}],
+            [inline({}), inline({"seed": 43})],
+            [{"protocol": "inline", "format": "json",
+              "uri": base64.b64encode(b'{"seed":42,"seed":43}').decode()}],
+        ]
+        for inputs in bad:
+            with self.subTest(inputs=inputs):
+                self.assert_untouched(self.post(inputs=inputs))
+
+    def test_valid_direct_grpc_call_preserves_positive_seed(self):
+        context = Mock()
+        result = ops.DataSynthesizerServicer().ConfigureAndSynthesize(
+            ops.data_synthesizer_pb2.GridSynthesisRequest(seed=73), context)
+        self.assertTrue(result.success)
+        self.configurator.assert_called_once_with(seed=73)
+        self.generator.assert_called_once_with(seed=73)
+        self.assertEqual(result.grid_data.seed, 73)
+        context.set_code.assert_not_called()
+
+    def test_omitted_direct_grpc_seed_preserves_42(self):
+        result = ops.DataSynthesizerServicer().ConfigureAndSynthesize(
+            ops.data_synthesizer_pb2.GridSynthesisRequest(), Mock())
+        self.assertTrue(result.success)
+        self.configurator.assert_called_once_with(seed=42)
+        self.generator.assert_called_once_with(seed=42)
+
+    def test_explicit_direct_grpc_zero_keeps_existing_default_semantics(self):
+        result = ops.DataSynthesizerServicer().ConfigureAndSynthesize(
+            ops.data_synthesizer_pb2.GridSynthesisRequest(seed=0), Mock())
+        self.assertTrue(result.success)
+        self.configurator.assert_called_once_with(seed=42)
+        self.generator.assert_called_once_with(seed=42)
+
+    def test_negative_direct_grpc_seed_rejects_without_defaults(self):
+        context = Mock()
+        result = ops.DataSynthesizerServicer().ConfigureAndSynthesize(
+            ops.data_synthesizer_pb2.GridSynthesisRequest(seed=-1), context)
+        self.assertFalse(result.success)
+        context.set_code.assert_called_once_with(grpc.StatusCode.INVALID_ARGUMENT)
+        self.configurator.assert_not_called()
+        self.generator.assert_not_called()
+        self.assertIs(ops._cached_config_response, self.original_config)
+        self.assertIs(ops._cached_grid_response, self.original_grid)
+
+    def test_capabilities_match_only_the_implemented_operation(self):
+        cap = self.client.get("/control/capabilities").json()
+        self.assertEqual(cap["transports"], ["http-parameters-v1"])
+        self.assertEqual([v["operation_name"] for v in cap["operations"]],
+                         ["ConfigureAndSynthesize"])
+        self.assertEqual(cap["operations"][0]["execution_parameters"], EXECUTION_PARAMETERS)
+        self.assertNotIn("enum", EXECUTION_PARAMETERS["properties"]["seed"])
+        self.assertEqual(EXECUTION_PARAMETERS["properties"]["seed"]["default"], ops.DEFAULT_SEED)
+        match_wrapper_configuration("ConfigureAndSynthesize", envelope(), cap)
+        self.assertEqual(capabilities(["ConfigureGrid"])["operations"], [])
+        for method in ("ConfigureGrid", "SynthesizeGrid"):
+            with self.subTest(method=method):
+                self.assert_untouched(self.post(method=method, configuration=envelope()))
+
+    def test_unsupported_capability_protocol_and_version_do_not_negotiate(self):
+        good = capabilities(["ConfigureAndSynthesize"])
+        for changes in ({"capability_schema_version": "2.0"},
+                        {"transports": ["http-parameters-v2"]}):
+            with self.subTest(changes=changes), self.assertRaises(ValueError):
+                match_wrapper_configuration("ConfigureAndSynthesize", envelope(), {**good, **changes})
+        changed = envelope()
+        changed["contract_version"] = "0.1.0-draft.1"
+        with self.assertRaises(ValueError):
+            match_wrapper_configuration("ConfigureAndSynthesize", changed, good)
+        self.configurator.assert_not_called()
+        self.generator.assert_not_called()
+
+    def test_direct_handler_rechecks_validation_before_algorithms(self):
+        request = control.ExecuteRequest(method="ConfigureAndSynthesize",
+                                         workflow_id="unit", task_id="protected-task")
+        request.configuration = envelope(True)
+        with self.assertRaises(ValueError):
+            ops.execute_ConfigureAndSynthesize(request)
+        self.configurator.assert_not_called()
+        self.generator.assert_not_called()
+        self.assertIs(ops._cached_grid_response, self.original_grid)
+
+    def test_direct_model_validation_is_strict_too(self):
+        for value in (True, "43", 43.5):
+            with self.subTest(value=value), self.assertRaises(ValidationError):
+                control.ExecuteRequest(method="ConfigureAndSynthesize",
+                    workflow_id="unit", task_id="unit", configuration=envelope(value))
+
+    def test_validator_is_exactly_the_recorded_shared_artifact(self):
+        root = Path(__file__).resolve().parents[2]
+        provenance = json.loads((root / "parameter_contract_provenance.json").read_text())
+        self.assertEqual(hashlib.sha256((root / "common/parameter_contract.py").read_bytes()).hexdigest(),
+                         provenance["sha256"])
