@@ -0,0 +1,53 @@
+"""Proposed generator capability using the maintained http-parameters-v1 protocol.
+
+The identity/version are review drafts, not active production registry authority.
+Only ConfigureAndSynthesize implements this capability.
+"""
+from copy import deepcopy
+
+from .parameter_contract import effective_parameters, match_wrapper_configuration
+
+OPERATION_IDENTITY = "urn:aieffect:proposal:nl:imported:ConfigureAndSynthesize"
+CONTRACT_VERSION = "0.2.0-draft.1"
+# Intersection of nonnegative NumPy RandomState seed range and signed int32
+# GridSynthesisConfig/GridData fields. See INSTANCE_PARAMETERS.md for provenance.
+SEED_SPEC = {
+    "type": "integer", "title": "Random seed",
+    "description": "Nonnegative seed within signed-int32 storage; scientific suitability is unverified.",
+    "minimum": 0, "maximum": 2**31 - 1, "default": 42,
+}
+EXECUTION_PARAMETERS = {
+    "schema_version": "1.0",
+    "transport": "http-parameters-v1",
+    "properties": {"seed": SEED_SPEC},
+}
+
+
+def capabilities(methods):
+    operations = []
+    if "ConfigureAndSynthesize" in methods:
+        operations.append({
+            "operation_name": "ConfigureAndSynthesize",
+            "operation_identity": OPERATION_IDENTITY,
+            "contract_version": CONTRACT_VERSION,
+            "execution_parameters": deepcopy(EXECUTION_PARAMETERS),
+        })
+    return {"capability_schema_version": "1.0",
+            "transports": ["http-parameters-v1"] if operations else [],
+            "operations": operations}
+
+
+def validate_request(request):
+    # The maintained WP3 client omits both fields for ordinary legacy requests.
+    # A bare parameters object is not a validated configuration envelope.
+    if "parameters" in request.model_fields_set:
+        raise ValueError("Use the supported configuration envelope, not bare parameters")
+    if "configuration" in request.model_fields_set:
+        match_wrapper_configuration(
+            request.method, request.configuration,
+            capabilities(["ConfigureAndSynthesize"]),
+        )
+
+
+def validate_seed(value):
+    return effective_parameters(EXECUTION_PARAMETERS, {"seed": value})["seed"]
