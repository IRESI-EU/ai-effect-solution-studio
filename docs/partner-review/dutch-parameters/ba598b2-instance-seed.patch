+def _combined_configuration_request(request: ExecuteRequest) -> ExecuteRequest:
+    """Validate all seed sources before configuration, generation or cache writes."""
+    validate_request(request)
+    params = {}
+    if request.inputs:
+        if len(request.inputs) != 1 or request.inputs[0].get("protocol") != "inline":
+            raise ValueError("ConfigureAndSynthesize accepts at most one inline configuration")
+
+        def unique_keys(pairs):
+            result = {}
+            for key, value in pairs:
+                if key in result:
+                    raise ValueError("Duplicate inline configuration key: " + key)
+                result[key] = value
+            return result
+
+        try:
+            raw = base64.b64decode(request.inputs[0].get("uri", ""), validate=True)
+            params = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_keys)
+        except (ValueError, TypeError, UnicodeError) as exc:
+            raise ValueError("Invalid inline configuration: " + str(exc)) from exc
+        if not isinstance(params, dict):
+            raise ValueError("Inline configuration must be a JSON object")
+        unknown = set(params) - {
+            "level_specs", "connection_specs", "seed", "loading_level", "ref_sys_id"
+        }
+        if unknown:
+            raise ValueError("Unsupported inline settings: " + ", ".join(sorted(unknown)))
+        if "seed" in params:
+            validate_seed(params["seed"])
+
+    if request.configuration is not None:
+        if "seed" in params:
+            raise ValueError(
+                "Seed supplied by both inline configuration and configuration envelope; "
+                "supply it exactly once, even when the values agree"
+            )
+        params["seed"] = request.configuration["parameters"]["seed"]
+
+    # Pass the validated seed into the existing ConfigureGrid -> SynthesizeGrid
+    # path. The unimplemented individual operations receive no new envelope.
+    return ExecuteRequest(
+        method="ConfigureGrid", workflow_id=request.workflow_id, task_id=request.task_id,
+        inputs=[{"protocol": "inline", "format": "json",
+                 "uri": base64.b64encode(json.dumps(params).encode("utf-8")).decode("ascii")}],
+    )
+
+
